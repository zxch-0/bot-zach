# ============================================================
#  ZachServices — Configuration
#  Copiez ce fichier en ".env" puis remplissez les valeurs :
#    cp .env.example .env
# ============================================================

# --- OBLIGATOIRE ---------------------------------------------

# Le token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# L'ID de l'application (Discord Developer Portal > General Information > APPLICATION ID)
CLIENT_ID=

# Votre ID Discord (pour recevoir les MP d'achat de la boutique).
# Activez le Mode développeur sur Discord, puis clic droit sur votre pseudo > "Copier l'identifiant utilisateur".
ADMIN_USER_ID=

# --- OPTIONNEL ----------------------------------------------

# ID d'un serveur pour enregistrer les commandes instantanément (utile en développement).
# Laissez vide en production : les commandes seront globales (mise à jour en ~1 h).
GUILD_ID=

# ID d'un salon où logguer les achats en plus du MP admin (clic droit sur le salon > Copier l'identifiant).
PURCHASE_LOG_CHANNEL_ID=

# --- Base de données ----------------------------------------

# json     : fichier local data/zach.json (par défaut, idéal en local / sur un disque persistant)
# postgres : base PostgreSQL distante (obligatoire sur les hébergeurs gratuits au disque éphémère, ex : Render + Neon)
DATABASE_DRIVER=json

# Chaîne de connexion PostgreSQL (uniquement si DATABASE_DRIVER=postgres)
# Exemple Neon (gratuit) : postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Réglages du jeu (valeurs par défaut) -------------------

# Récompense du /daily (par défaut : 100)
DAILY_REWARD=100

# Cooldown du /daily en heures (par défaut : 24)
DAILY_COOLDOWN_HOURS=24

# --- Keep-alive (hébergement gratuit) -----------------------

# Mettre "true" pour démarrer un mini serveur web (ping UptimeRobot sur Render, etc.)
KEEP_ALIVE=true

# Port du serveur keep-alive (Render le fournit automatiquement)
PORT=3000
