# ============================================================
#  Ollama Web — Configuration
#  Copiez ce fichier en ".env" :   cp .env.example .env
#  Puis remplissez ce dont vous avez besoin (tout est optionnel).
# ============================================================

# --- Serveur web --------------------------------------------
# Port d'écoute (Render / Hugging Face le fournissent automatiquement)
PORT=3000

# Adresse d'écoute. Laissez 0.0.0.0 pour que le site soit joignable
# depuis l'extérieur du conteneur (obligatoire sur Render / Docker).
HOST=0.0.0.0

# --- Sécurité (RECOMMANDÉ en production) --------------------
# Mot de passe pour ouvrir le site. Si vide, le site est PUBLIC :
# n'importe qui pourrait consommer votre clé API / votre GPU.
APP_PASSWORD=

# Secret de signature des cookies de session. Si vide, un secret
# aléatoire est généré à chaque démarrage (les sessions sautent
# alors à chaque redéploiement).
SESSION_SECRET=

# Durée d'une session, en jours (défaut : 30)
SESSION_TTL_DAYS=30

# --- Fournisseur 1 : Ollama Cloud (le plus simple) ----------
# Clé créée sur https://ollama.com/settings/keys
# Les modèles tournent CHEZ OLLAMA : aucun GPU, aucune installation.
OLLAMA_CLOUD_API_KEY=
# Modèle cloud proposé par défaut (facultatif : la liste est
# récupérée automatiquement depuis ollama.com/api/tags)
OLLAMA_CLOUD_MODEL=

# --- Fournisseur 2 : Ollama distant (Colab, VPS, PC maison) --
# Exemple Colab + tunnel : https://xxxx.trycloudflare.com
# Exemple VPS : https://ollama.mondomaine.fr
OLLAMA_REMOTE_URL=
OLLAMA_REMOTE_LABEL=Ollama distant
# Certains reverse-proxys (Cloudflare Access, nginx basic-auth…) exigent un en-tête
OLLAMA_REMOTE_API_KEY=
OLLAMA_REMOTE_MODEL=

# --- Fournisseur 3 : Ollama local (développement) -----------
# Utilisé quand vous lancez le site sur la même machine qu'Ollama.
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=
# "true" pour ne pas afficher le fournisseur local (déploiement cloud pur)
DISABLE_LOCAL_PROVIDER=

# --- Fournisseur 4 : n'importe quelle API compatible OpenAI --
# Groq, OpenRouter, LM Studio, vLLM, llama.cpp server, Together, etc.
# Attention : ce ne sont pas des modèles Ollama, juste une porte de secours.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_LABEL=
OPENAI_MODEL=

# --- Fournisseurs supplémentaires (avancé) ------------------
# Une ligne par fournisseur : id|libellé|type|url|clé|modèle
#   type : ollama | openai
# Exemple :
# PROVIDERS_EXTRA=labo|Serveur du labo|ollama|https://ollama.exemple.fr|secret123|qwen2.5:7b
PROVIDERS_EXTRA=

# --- Préférences --------------------------------------------
# Fournisseur sélectionné par défaut (id : cloud, remote, local, openai, …)
DEFAULT_PROVIDER=

# Prompt système appliqué aux nouvelles discussions
SYSTEM_PROMPT=Tu es un assistant francophone, précis et concis.

# Autoriser le téléchargement (pull) de modèles depuis l'interface
ALLOW_PULL=true

# --- Limites (protège les offres gratuites) -----------------
REQUEST_TIMEOUT_MS=300000
MAX_MESSAGES=60
MAX_BODY_KB=512
RATE_LIMIT_PER_MINUTE=60
MAX_CONTEXT_CHARS=48000

# --- Divers -------------------------------------------------
# 1 pour afficher chaque requête HTTP dans les logs
VERBOSE=1
