# ============================================================
#  Ollama Web « tout-en-un » : Ollama + le site dans UN SEUL conteneur.
#
#  À utiliser quand vous voulez héberger Ollama dans le cloud sans compte
#  Ollama Cloud : Hugging Face Spaces (gratuit, CPU), Fly.io, Koyeb, Render
#  (plan payant uniquement pour Docker)…
#
#  ⚠️ Sur CPU (offres gratuites), seuls les petits modèles sont utilisables :
#     qwen2.5:0.5b (≈0,4 Go), llama3.2:1b (≈1,3 Go), qwen2.5:3b (≈2 Go).
#     Le premier démarrage télécharge le modèle (patience !).
#
#  Hugging Face Spaces : ce fichier doit s'appeler « Dockerfile » dans le
#  Space, et le port doit être 7860 (valeur par défaut ci-dessous).
# ============================================================
FROM ollama/ollama:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PORT=7860 \
    HOST=0.0.0.0 \
    PULL_MODEL=qwen2.5:0.5b \
    DEFAULT_PROVIDER=local \
    ALLOW_PULL=true \
    OLLAMA_KEEP_ALIVE=30m

# Node.js 22 (pour servir le site) + curl (pour le healthcheck)
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json ./
COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY docker ./docker
COPY .env.example ./
RUN chmod +x /app/docker/entrypoint-allinone.sh

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/healthz" || exit 1

ENTRYPOINT ["/app/docker/entrypoint-allinone.sh"]
